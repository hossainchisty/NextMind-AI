DEBUG=True

SECRET_KEY=

DATABASE_NAME=nextmind
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

REDIS_URL=redis://localhost:6379/0
# Use rediss://... once TLS is enabled on the Redis server; Celery
# verifies certificates automatically for rediss:// URLs.

# Production: serve with DJANGO_SETTINGS_MODULE=config.settings.production
# and set ALLOWED_HOSTS to your domain(s).

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

LLM_PROVIDER=openai
LLM_MODEL=auto
LLM_BASE_URL=http://localhost:20128/v1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OAuth SSO (Sign in with Google) — leave empty to disable.
# Register this redirect URI in Google Cloud Console (web application type):
#   <backend-origin>/api/v1/auth/oauth/google-oauth2/callback/
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAX_UPLOAD_SIZE=104857600
MAX_UPLOAD_BATCH_SIZE=40

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudflare R2 Storage (S3-compatible)
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
